[Unit]
Description=Sahmat KPSS Next.js
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sahmatkpss/current/.next/standalone
EnvironmentFile=/home/ubuntu/sahmatkpss.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3002
Environment=NODE_OPTIONS=--max-old-space-size=320
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
UMask=0027

[Install]
WantedBy=multi-user.target
